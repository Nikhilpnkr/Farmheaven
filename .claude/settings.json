{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "pnpm exec biome check --write apps/web/src packages 2>&1 | tail -30",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "bash scripts/check-admin-import-boundary.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
