{
  "extends": "@farmheaven/config/tsconfig.nextjs.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts",
    "__tests__/**/*.ts",
    "__tests__/**/*.tsx",
    "instrumentation-client.ts",
    "instrumentation.ts",
    "sentry.server.config.ts",
    "sentry.edge.config.ts",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules"]
}
