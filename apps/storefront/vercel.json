{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "cd ../.. && pnpm turbo run build --filter=@farmheaven/storefront...",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
